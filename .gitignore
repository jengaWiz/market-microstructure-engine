# Build output
build/
cmake-build-*/
out/

# CMake artifacts (in case of an in-source build)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json

# Compiled objects
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Market data: recordings can be large, so keep them out of git.
# The .gitkeep files keep the directory layout in the repository.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
